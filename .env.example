# arnmap local integration-test configuration
#
# Copy this file to .env:
#   cp .env.example .env
#
# Do NOT put AWS access keys or secret keys in this file.
# Use an AWS CLI profile instead, for example:
#   aws configure --profile arnmap-test
#   export AWS_PROFILE=arnmap-test

# AWS account that the integration suite is expected to use.
ARNMAP_TEST_ACCOUNT_ID=

# Existing AWS resources used by integration tests.
ARNMAP_TEST_DMS_ARN=
ARNMAP_TEST_EC2_ARN=
ARNMAP_TEST_GLUE_JOB_NAME=
ARNMAP_TEST_GLUE_WORKFLOW_NAME=
ARNMAP_TEST_LAMBDA_ARN=
ARNMAP_TEST_RDS_CLUSTER_ARN=
ARNMAP_TEST_RDS_INSTANCE_ARN=
ARNMAP_TEST_REDSHIFT_CLUSTER_ARN=

# Optional region used by the integration environment.
# Prefer the AWS profile/configuration for the actual AWS region.
AWS_REGION=
